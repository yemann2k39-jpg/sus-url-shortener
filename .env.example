# --- Database (Turso / LibSQL) ---
# Leave TURSO_DATABASE_URL empty for local dev: the app then uses a plain
# SQLite file at data/links.db (zero config). For production on Vercel,
# create a Turso database and fill in:
#   TURSO_DATABASE_URL  e.g. libsql://your-db-your-org.turso.io
#   TURSO_AUTH_TOKEN    from `turso db tokens create <db>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Brevo email verification (https://app.brevo.com -> SMTP & API -> API keys) ---
# Leave BREVO_API_KEY empty to run in dev mode: verification links are printed
# to the server console (and shown in the UI) instead of being emailed.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Sus URL Shortener
